# Cybte AI production environment template
# Copy to .env on the server or configure these values in the hosting environment.
# NEVER commit the real .env file.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.cybte.com
APP_NAME="Cybte AI"
APP_TIMEZONE=UTC

# Database — use a dedicated least-privilege application user.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cybte
DB_USER=cybte_app
DB_PASS=replace_with_a_new_strong_password

# Security
# Generate a new key with: openssl rand -base64 32
APP_KEY=base64:REPLACE_WITH_A_NEW_32_BYTE_BASE64_KEY
SESSION_LIFETIME=120

# Secure Vault
# Use a path outside the public web root. The web-server/PHP user must have read/write access.
VAULT_STORAGE_PATH=/var/lib/cybte/vault

# Email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@cybte.com
MAIL_FROM_NAME="Cybte AI"
# Optional Resend alternative
RESEND_API_KEY=

# Payment configuration
# IMPORTANT: production must use real provider credentials. Do not expose fake/test checkout as production payment.
AIRWALLEX_MODE=production
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
PAYPAL_MODE=production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# VPN / 3x-ui — rotate any credentials or cookies that were ever committed.
VPN_PANEL_HOST=
VPN_PANEL_PORT=54321
VPN_PANEL_BASE_PATH=/
VPN_PANEL_USERNAME=
VPN_PANEL_PASSWORD=
VPN_DEFAULT_INBOUND_ID=1
VPN_SSH_KEY_PATH=

# API / future integrations
API_RATE_LIMIT=60
API_KEY=
JWT_SECRET=
JWT_EXPIRATION=3600
FRAUD_API_KEY=
FRAUD_API_URL=
VERIFY_API_KEY=
VERIFY_API_URL=

# Optional anti-abuse service
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Logging
LOG_LEVEL=error
LOG_PATH=/var/log/cybte
DISPLAY_ERRORS=false
