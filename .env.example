<?php
/**
 * TrustShield AI - Production Environment Configuration
 * 
 * Copy this file to .env and fill in your actual values
 * DO NOT commit .env to version control (it's in .gitignore)
 */

// ============================================================================
// APPLICATION CONFIGURATION
// ============================================================================

// Application Environment: development, staging, production
putenv('APP_ENV=production');

// Application Debug Mode: true (dev) or false (production)
putenv('APP_DEBUG=false');

// Application URL (your domain)
putenv('APP_URL=https://www.cybte.com');

// Application Name
putenv('APP_NAME=TrustShield AI');

// Time Zone
putenv('APP_TIMEZONE=Asia/Shanghai');

// ============================================================================
// DATABASE CONFIGURATION
// ============================================================================

// Database Host (usually localhost for same server)
putenv('DB_HOST=localhost');

// Database Port (MySQL default: 3306)
putenv('DB_PORT=3306');

// Database Name
putenv('DB_NAME=trustshield');

// Database Username (create a dedicated user, not root)
putenv('DB_USER=trustshield_user');

// Database Password (use strong password)
putenv('DB_PASS=your_strong_database_password_here');

// Database Charset
putenv('DB_CHARSET=utf8mb4');

// ============================================================================
// PAYMENT CONFIGURATION
// ============================================================================

// Payment Mode: 'fake' (testing), 'airwallex' (production aggregator), 'direct' (direct API)
putenv('ALIPAY_MODE=fake');
putenv('WECHATPAY_MODE=fake');

// Airwallex Configuration (for production payments)
putenv('AIRWALLEX_CLIENT_ID=your_airwallex_client_id');
putenv('AIRWALLEX_API_KEY=your_airwallex_api_key');
putenv('AIRWALLEX_WEBHOOK_SECRET=your_airwallex_webhook_secret');

// ============================================================================
// VPN SERVICE CONFIGURATION
// ============================================================================

// 3x-ui Panel Configuration
putenv('VPN_PANEL_HOST=your_vps_ip');
putenv('VPN_PANEL_PORT=54321');
putenv('VPN_PANEL_BASE_PATH=/JE2fu7rGygZsRGQwEW/');
putenv('VPN_SSH_KEY_PATH=/path/to/ssh/key');

// Default Inbound ID for new clients
putenv('VPN_DEFAULT_INBOUND_ID=1');

// ============================================================================
// SECURITY CONFIGURATION
// ============================================================================

// Session Configuration
putenv('SESSION_LIFETIME=120'); // minutes
putenv('SESSION_SECURE=true'); // true for HTTPS
putenv('SESSION_HTTP_ONLY=true');
putenv('SESSION_SAME_SITE=Strict');

// CSRF Protection
putenv('CSRF_TOKEN_SECRET=your_random_csrf_secret_key_here');

// Encryption Key (generate with: openssl rand -base64 32)
putenv('APP_KEY=base64:your_base64_encoded_random_key_here');

// Admin Credentials (change these!)
putenv('ADMIN_EMAIL=admin@cybte.com');
putenv('ADMIN_PASSWORD_HASH=your_bcrypt_password_hash');

// ============================================================================
// EMAIL CONFIGURATION (for notifications)
// ============================================================================

// SMTP Settings
putenv('MAIL_DRIVER=smtp');
putenv('MAIL_HOST=smtp.gmail.com');
putenv('MAIL_PORT=587');
putenv('MAIL_USERNAME=your_email@gmail.com');
putenv('MAIL_PASSWORD=your_app_password');
putenv('MAIL_ENCRYPTION=tls');
putenv('MAIL_FROM_ADDRESS=noreply@cybte.com');
putenv('MAIL_FROM_NAME=TrustShield AI');

// ============================================================================
// API CONFIGURATION
// ============================================================================

// API Rate Limiting (requests per minute)
putenv('API_RATE_LIMIT=60');

// API Key for external services
putenv('API_KEY=your_api_key_here');

// JWT Secret (for API authentication)
putenv('JWT_SECRET=your_jwt_secret_key_here');
putenv('JWT_EXPIRATION=3600'); // seconds

// ============================================================================
// EXTERNAL SERVICES
// ============================================================================

// Fraud Detection Service
putenv('FRAUD_API_KEY=your_fraud_api_key');
putenv('FRAUD_API_URL=https://api.fraudservice.com');

// Identity Verification Service
putenv('VERIFY_API_KEY=your_verify_api_key');
putenv('VERIFY_API_URL=https://api.identityverify.com');

// reCAPTCHA (for forms)
putenv('RECAPTCHA_SITE_KEY=your_recaptcha_site_key');
putenv('RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key');

// ============================================================================
// CACHE AND PERFORMANCE
// ============================================================================

// Cache Driver: file, redis, memcached
putenv('CACHE_DRIVER=file');
putenv('CACHE_PREFIX=trustshield');

// Redis Configuration (if using Redis)
putenv('REDIS_HOST=127.0.0.1');
putenv('REDIS_PORT=6379');
putenv('REDIS_PASSWORD=null');

// ============================================================================
// LOGGING
// ============================================================================

// Log Level: debug, info, warning, error
putenv('LOG_LEVEL=error');

// Log Path
putenv('LOG_PATH=/var/www/cybte.com/logs');

// ============================================================================
// DEVELOPMENT ONLY (set to false in production)
// ============================================================================

// Display errors (false in production)
putenv('DISPLAY_ERRORS=false');

// Enable query logging (false in production)
putenv('DB_QUERY_LOG=false');
